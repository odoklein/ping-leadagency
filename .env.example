# ============================================
# Database (PostgreSQL - Neon)
# ============================================
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ============================================
# NextAuth Configuration
# ============================================
NEXTAUTH_URL="http://localhost:5000"
NEXTAUTH_SECRET="your-nextauth-secret"

# ============================================
# Analytics — OpenReplay (self-hosted session replay)
# Project key comes from your OpenReplay dashboard (Preferences > Projects).
# ============================================
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=""
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT="https://openreplay.suzaliconseil.com/ingest"

# ============================================
# Phone & VoIP Integrations (Allo, Onoff & Ringover)
# ============================================
# WithAllo
ALLO_API_KEY=""
ALLO_NUMBERS=""

# Onoff Business API
ONOFF_API_KEY=""
ONOFF_NUMBERS=""

# Ringover
RINGOVER_API_KEY=""
RINGOVER_WEBHOOK_SECRET=""
