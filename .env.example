# ============================================
# Database (PostgreSQL - Neon)
# ============================================
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ============================================
# NextAuth Configuration
# ============================================
NEXTAUTH_URL="http://localhost:5000"
NEXTAUTH_SECRET="your-nextauth-secret"

# ============================================
# Analytics — OpenReplay (self-hosted session replay)
# Project key comes from your OpenReplay dashboard (Preferences > Projects).
# ============================================
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=""
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT="https://openreplay.suzaliconseil.com/ingest"

# ============================================
# Phone & VoIP Integrations (Allo, Onoff & Ringover)
# ============================================
# WithAllo
ALLO_API_KEY=""
ALLO_NUMBERS=""

# Onoff Business API
ONOFF_API_KEY=""
ONOFF_NUMBERS=""

# Ringover
RINGOVER_API_KEY=""
RINGOVER_WEBHOOK_SECRET=""

# ============================================
# AI — Mistral (sole provider)
# ============================================
MISTRAL_API_KEY=""

# Model used by the assistant's tool-calling loop.
# Defaults to mistral-large-latest. Pin a smaller model when the account tier
# rejects Large (tier_not_allowed) — that also skips a wasted probe call per
# cold start. e.g. mistral-small-latest
MISTRAL_LARGE_MODEL=""

# Model used by the one-shot AI routes (email drafts, rdv-fiche, reports...).
# Defaults to mistral-small-latest.
MISTRAL_MODEL=""
